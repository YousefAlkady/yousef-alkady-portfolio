# Cloudflare Pages response headers. Long caching = repeat visits download nothing.
# Next's build files have a content hash in their name, so they can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Media keep fixed names (h1.mp4 ...), so cache 30 days in browsers, 1 year at Cloudflare's edge.
# After replacing a clip, purge the cache in Cloudflare (Caching > Purge) or rename the file.
/media/*
  Cache-Control: public, max-age=2592000, s-maxage=31536000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' mailto:
